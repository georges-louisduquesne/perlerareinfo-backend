#!/usr/bin/env bash
# Refuses a push whose code changes break the build or the tests. Enabled by: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

ZERO=0000000000000000000000000000000000000000
CODE='^(api-perle-rare-decompiled/|tests/|[^/]*\.sln$)'
run=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
	[[ "$local_sha" == "$ZERO" ]] && continue
	if [[ "$remote_sha" == "$ZERO" ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
		run=1
	elif git diff --name-only "$remote_sha" "$local_sha" | grep -qE "$CODE"; then
		run=1
	fi
done
[[ $run == 1 ]] || exit 0

if git grep -nE 'Skip *=' -- 'tests/*.cs'; then
	echo "pre-push: skipped tests hide regressions — remove Skip =." >&2
	exit 1
fi

if [[ -x "$HOME/.dotnet/dotnet" ]]; then
	export DOTNET_ROOT="$HOME/.dotnet" PATH="$HOME/.dotnet:$PATH"
fi
echo "pre-push: code changed — build + unit tests"
if ! (dotnet build ApiPerleRare.sln -c Release && dotnet test tests/ApiPerleRare.Tests -c Release --no-build); then
	echo "pre-push: build or tests red — push refused. Fix the code or the test; never --no-verify." >&2
	exit 1
fi
