[Unit]
Description=API Perle-rare DEMO (isolated, not production)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/administrateur/api-client-demo
ExecStart=/home/administrateur/api-client-demo/ApiPerleRare
User=administrateur
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=PR_LOCAL_SAFE=1
Environment=PR_DEMO_PATH_PREFIX=/api-demo
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_EnableDiagnostics=0
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
MemoryMax=512M

[Install]
WantedBy=multi-user.target
